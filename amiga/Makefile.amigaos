# Beret for GFOS (AmigaOS 3.2 with GFOpenUp), 68040/68060 + FPU, on
# GFOpenUp's SDL 2 (LIBS:GFOpenGPU/SDL2.module, SDL2_image.module and
# SDL2_mixer.module; SDL2_ttf and FreeType are linked in from the kit).
#
#   make -f amiga/Makefile.amigaos -j4 BERET=/path/to/beret [STOVE=/path/to/os32-gcc16-open6]
#
# BERET is upstream Beret at the commit package/beret.lock names, with
# amiga/patches applied (package/build-amiga.sh fetches and patches it).
# STOVE is a GFOpenAmigaGCC 16.2.0-open6 stove: its prefix/ has the
# compiler, the NDK and GFOpenGPU's SDL 2 kit (prefix/m68k-amigaos).
#
# Beret was written for SDL 1.2: amiga/beret_amiga.h and beret_sdl.c turn
# its screen calls into SDL 2 ones, and beret_le.c keeps its save and room
# files little-endian, as the shipped ones are.
#
# Output: build/amigaos/Beret/ (the drawer: Beret, Data/ with the pictures,
# rooms, sounds, music and font, User/, ReadMe, Controls, the licences,
# with GlowIcons), build/amigaos/Beret.info and Install-Beret beside them.

BERET   ?= ../beret
STOVE   ?= $(HOME)/AmiCradle/stoves/os32-gcc16-open6
PREFIX  ?= $(STOVE)/prefix
SDL2KIT ?= $(PREFIX)/m68k-amigaos
CC      = $(PREFIX)/bin/m68k-amigaos-gcc
STRIP   = $(PREFIX)/bin/m68k-amigaos-strip
# hard float: GFOpenGPU's SDL 2 kit is built -m68881
CPU     ?= -m68040 -m68881
# -fno-tree-loop-distribute-patterns: GCC 16's loop miscompile (the kit's
# sdl2-config gives it for GCC 16 too).
OPT     ?= -O2 -fomit-frame-pointer -fno-tree-loop-distribute-patterns -fno-math-errno

DEFS    = -D__amigaos__ -DRESOURCE_PATH='"PROGDIR:Data/"'
INC     = -Iamiga -I$(BERET) -I$(SDL2KIT)/include/SDL2
# the game is 2011 C: implicit declarations and int/pointer mixing are warnings
CFLAGS  = -noixemul $(OPT) $(CPU) -std=gnu99 -fcommon -Wno-implicit-function-declaration \
          -Wno-int-conversion -Wno-incompatible-pointer-types $(DEFS) $(INC)
LDFLAGS = -noixemul $(CPU)
LIBS    = -L$(SDL2KIT)/lib -L$(SDL2KIT)/port-deps/lib -lSDL2_ttf -lfreetype -lSDL2_image -lSDL2_mixer -lSDL2 -lm

BUILD   = build/amigaos
OBJDIR  = $(BUILD)/obj
OUT     = $(BUILD)/Beret
PROG    = Beret

OBJS    = $(OBJDIR)/game.o $(OBJDIR)/thing.o $(OBJDIR)/physics.o \
          $(OBJDIR)/amiga/beret_sdl.o $(OBJDIR)/amiga/beret_le.o $(OBJDIR)/amiga/amiga_start.o
DATA    = images rooms sfx music AveriaSans-Regular.ttf

all: $(OUT)/$(PROG) package

$(BUILD)/$(PROG).debug: $(OBJS)
	@mkdir -p $(BUILD)
	$(CC) $(LDFLAGS) -o $@ $(OBJS) $(LIBS)

$(OUT)/$(PROG): $(BUILD)/$(PROG).debug
	@mkdir -p $(OUT)
	$(STRIP) -o $@ $<

package: $(OUT)/$(PROG) AMIGA_PORT.md amiga/Licences.txt amiga/Controls
	mkdir -p $(OUT)/User $(OUT)/Data
	for d in $(DATA); do rm -rf $(OUT)/Data/$$d; cp -R $(BERET)/$$d $(OUT)/Data/$$d; done
	cp amiga/Controls $(OUT)/Controls
	cp AMIGA_PORT.md $(OUT)/ReadMe
	cp $(BERET)/lgpl-3.0.txt $(OUT)/LGPL-3.0.txt
	cp $(BERET)/OFL.txt $(OUT)/OFL.txt
	cp $(BERET)/README.txt $(OUT)/README-Beret.txt
	cp amiga/Licences.txt $(OUT)/Licences.txt
	cp amiga/icons/Beret.info amiga/icons/ReadMe.info $(OUT)/
	for f in LGPL-3.0.txt OFL.txt README-Beret.txt Licences.txt Controls; do \
	    cp amiga/icons/ReadMe.info $(OUT)/$$f.info; done
	cp amiga/icons/Data.info $(OUT)/User.info
	cp amiga/icons/Data.info $(OUT)/Data.info
	cp amiga/icons/Beret-drawer.info $(BUILD)/Beret.info
	cp amiga/Install-Beret amiga/Install-Beret.info $(BUILD)/

$(OBJDIR)/%.o: $(BERET)/%.c $(wildcard $(BERET)/*.h) amiga/beret_amiga.h
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

$(OBJDIR)/amiga/%.o: amiga/%.c amiga/beret_amiga.h
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	rm -rf $(BUILD)

.PHONY: all package clean
